+#if OS(DARWIN) // Florence: crash report of a helper process
+static void floHelperCrash(int sig, siginfo_t* info, void* context)
+{
+    ucontext_t* uc = static_cast<ucontext_t*>(context);
+    uintptr_t pc = static_cast<uintptr_t>(__darwin_arm_thread_state64_get_pc(uc->uc_mcontext->__ss));
+    uintptr_t lr = static_cast<uintptr_t>(__darwin_arm_thread_state64_get_lr(uc->uc_mcontext->__ss));
+    uintptr_t* fp = reinterpret_cast<uintptr_t*>(__darwin_arm_thread_state64_get_fp(uc->uc_mcontext->__ss));
+    auto describe = [](int n, uintptr_t address) {
+        Dl_info di { };
+        if (dladdr(reinterpret_cast<void*>(address), &di) && di.dli_fname)
+            dprintf(2, "florence: helper   #%d %p  %s+%#lx  (%s)\n", n, reinterpret_cast<void*>(address), di.dli_sname ? di.dli_sname : "?", di.dli_saddr ? static_cast<unsigned long>(address - reinterpret_cast<uintptr_t>(di.dli_saddr)) : 0UL, di.dli_fname);
+        else
+            dprintf(2, "florence: helper   #%d %p\n", n, reinterpret_cast<void*>(address));
+    };
+    dprintf(2, "florence: helper process %d crashed: signal %d, fault address %p\n", getpid(), sig, info ? info->si_addr : nullptr);
+    describe(0, pc);
+    describe(1, lr);
+    for (int i = 2; i < 40 && fp && !(reinterpret_cast<uintptr_t>(fp) & 7) && reinterpret_cast<uintptr_t>(fp) > 0x10000; i++) {
+        describe(i, fp[1]);
+        if (fp[0] <= reinterpret_cast<uintptr_t>(fp))
+            break;
+        fp = reinterpret_cast<uintptr_t*>(fp[0]);
+    }
+    signal(sig, SIG_DFL);
+}
+#endif
